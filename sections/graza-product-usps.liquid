{{ 'graza-product-usps.css' | asset_url | stylesheet_tag }}

<section
  class="graza-product-usps"
  style="
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    --graza-usps-padding-top: {{ section.settings.padding_top }}px;
    --graza-usps-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="graza-product-usps__inner">
    {% if section.settings.heading != blank %}
      <h2 class="graza-product-usps__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="graza-product-usps__grid graza-product-usps__grid--{{ section.settings.columns_desktop }}">
      {% for block in section.blocks %}
        <div class="graza-product-usps__card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            {{
              block.settings.icon
              | image_url: width: 112
              | image_tag:
                class: 'graza-product-usps__icon',
                loading: 'lazy',
                widths: '56,112',
                sizes: '56px',
                alt: block.settings.heading
            }}
          {% else %}
            <div class="graza-product-usps__icon-placeholder" aria-hidden="true"></div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h3 class="graza-product-usps__card-heading">
              {{ block.settings.heading | escape }}
            </h3>
          {% endif %}

          {% if block.settings.description != blank %}
            <p class="graza-product-usps__card-description">
              {{ block.settings.description | escape }}
            </p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.graza_product_usps",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Sizzle?"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F5F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "usp_item",
      "name": "t:names.usp_item",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe a key benefit or feature of your product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.graza_product_usps",
      "blocks": [
        {
          "type": "usp_item",
          "settings": {
            "heading": "High Smoke Point",
            "description": "Perfect for sautéing, roasting, and frying at high temperatures."
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "heading": "100% Extra Virgin",
            "description": "Pure, unblended extra virgin olive oil from Puglia, Italy."
          }
        },
        {
          "type": "usp_item",
          "settings": {
            "heading": "Squeeze Bottle",
            "description": "Easy-to-use squeeze bottle for precise, mess-free pouring."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
