{{ 'graza-product-story.css' | asset_url | stylesheet_tag }}

<section
  class="graza-product-story"
  style="
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    --graza-story-padding-top: {{ section.settings.padding_top }}px;
    --graza-story-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="graza-product-story__inner">
    <div class="graza-product-story__layout{% if section.settings.image_position == 'right' %} graza-product-story__layout--image-right{% endif %}">
      <div class="graza-product-story__image-wrapper">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              class: 'graza-product-story__image',
              loading: 'lazy',
              widths: '375,550,750,1100',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: section.settings.heading
          }}
        {% else %}
          <div class="graza-product-story__image-placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>

      <div class="graza-product-story__content">
        {% if section.settings.heading != blank %}
          <h2 class="graza-product-story__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="graza-product-story__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <dl class="graza-product-story__details">
            {% for block in section.blocks %}
              <div class="graza-product-story__detail-item" {{ block.shopify_attributes }}>
                {% if block.settings.label != blank %}
                  <dt class="graza-product-story__detail-label">
                    {{ block.settings.label | escape }}
                  </dt>
                {% endif %}

                {% if block.settings.value != blank %}
                  <dd class="graza-product-story__detail-value">
                    {{ block.settings.value | escape }}
                  </dd>
                {% endif %}
              </div>
            {% endfor %}
          </dl>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.graza_product_story",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's Inside"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Our Sizzle olive oil is made from a blend of Coratina and Ogliarola olives, cold-pressed within hours of harvest in Puglia, Italy. The result is a robust, full-flavored oil that's perfect for cooking.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "detail_item",
      "name": "t:names.detail_item",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Detail"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.graza_product_story",
      "blocks": [
        {
          "type": "detail_item",
          "settings": {
            "label": "Origin",
            "value": "Puglia, Italy"
          }
        },
        {
          "type": "detail_item",
          "settings": {
            "label": "Olive Type",
            "value": "Coratina & Ogliarola"
          }
        },
        {
          "type": "detail_item",
          "settings": {
            "label": "Taste Profile",
            "value": "Robust, peppery, full-bodied"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
