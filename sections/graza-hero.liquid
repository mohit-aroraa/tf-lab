{{ 'graza-hero.css' | asset_url | stylesheet_tag }}

<div
  class="graza-hero__wrapper"
  style="
    --graza-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --graza-hero-text-color: {{ section.settings.text_color }};
  "
>
  {%- if section.settings.background_video_url != blank -%}
    <video
      class="graza-hero__media"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="{{ section.settings.background_video_url }}" type="video/mp4">
    </video>
  {%- elsif section.settings.background_image != blank -%}
    {{
      section.settings.background_image
      | image_url: width: section.settings.background_image.width
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'graza-hero__media',
        sizes: '100vw',
        widths: '375,750,1100,1500,1780,2000,2400',
        alt: section.settings.background_image.alt
    }}
  {%- endif -%}

  <div class="graza-hero__overlay" aria-hidden="true"></div>

  <div class="graza-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="graza-hero__heading">
        {{- section.settings.heading | escape -}}
      </h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="graza-hero__subheading">
        {{- section.settings.subheading | escape -}}
      </p>
    {%- endif -%}

    {%- if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank -%}
      <div class="graza-hero__ctas">
        {%- if section.settings.cta_primary_label != blank -%}
          <a
            href="{{ section.settings.cta_primary_url | default: '#' }}"
            class="graza-btn graza-hero__cta--primary"
          >
            {{- section.settings.cta_primary_label | escape -}}
          </a>
        {%- endif -%}

        {%- if section.settings.cta_secondary_label != blank -%}
          <a
            href="{{ section.settings.cta_secondary_url | default: '#' }}"
            class="graza-btn graza-hero__cta--secondary"
          >
            {{- section.settings.cta_secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Graza Hero",
  "tag": "section",
  "class": "graza-hero",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Extra Virgin Olive Oil"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "makes everything better"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "background_video_url",
      "label": "Background video URL",
      "info": "Enter a direct link to an MP4 video file. Takes priority over image when provided."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Graza Hero",
      "settings": {
        "heading": "Extra Virgin Olive Oil",
        "subheading": "makes everything better",
        "cta_primary_label": "Shop Now",
        "cta_secondary_label": "Learn More",
        "overlay_opacity": 30,
        "text_color": "#ffffff"
      }
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
